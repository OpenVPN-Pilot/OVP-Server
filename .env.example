# OpenVPN Pilot Server. Copy to .env and fill in. Every variable is described in docs/configuration.md.
# Values marked "required" have no default and stop the server with a message when missing.
# Any variable can instead be given as <NAME>_FILE, the path of a file holding the value, for
# Docker secrets: OVP_DATA_KEY_FILE=/run/secrets/ovp_data_key. Keep this file readable by you only.

# --- Database ---------------------------------------------------------------------------------
# required. Also used by the postgres container to create the database.
OVP_DB_PASSWORD=
OVP_DB_NAME=ovp
OVP_DB_USER=ovp
OVP_DB_PORT=5432
OVP_DB_MIGRATE_ON_START=true

# --- Keys -------------------------------------------------------------------------------------
# required. Encrypts profile configurations and vault entries. Exactly 32 bytes, Base64.
# Generate with: openssl rand -base64 32   Losing it makes every stored profile unreadable.
OVP_DATA_KEY=
# required. Signs access tokens. At least 32 bytes, Base64. Changing it signs everyone out.
OVP_JWT_SIGNING_KEY=
OVP_ACCESS_TOKEN_MINUTES=15
OVP_REFRESH_TOKEN_DAYS=30

# --- Swagger ----------------------------------------------------------------------------------
# The interactive API description at /swagger and /swagger/v1/swagger.json.
# true: on. false: both answer 404. Independent of any development setting.
OVP_SWAGGER_ENABLED=true

# --- TLS: HTTPS is mandatory ------------------------------------------------------------------
# required. kestrel: the server speaks HTTPS itself with the certificate below.
#           proxy:   a reverse proxy terminates TLS; the server listens on OVP_HTTP_PORT.
OVP_TLS_MODE=kestrel
OVP_HTTPS_PORT=8443
OVP_HTTP_PORT=8080
# kestrel mode: a PEM certificate with its key, or a .pfx/.p12 with OVP_TLS_CERT_PASSWORD.
OVP_TLS_CERT_PATH=/app/certs/server.crt
OVP_TLS_KEY_PATH=/app/certs/server.key
OVP_TLS_CERT_PASSWORD=
# proxy mode, required: addresses or CIDR networks whose X-Forwarded-Proto is believed.
OVP_TRUSTED_PROXIES=

# Host port and container port Compose publishes. In proxy mode set OVP_CONTAINER_PORT to OVP_HTTP_PORT,
# or remove the ports section and put the proxy on the same network.
OVP_PUBLISH_PORT=8443
OVP_CONTAINER_PORT=8443

# --- Authentication ---------------------------------------------------------------------------
# required. none | file | ldap | entra
OVP_AUTH_MODE=file
OVP_LOGIN_ATTEMPTS_PER_MINUTE=10

# none: no authentication at all. Comma separated user names that are administrators.
OVP_AUTH_NONE_ADMINS=

# file: path inside the container. ./config is mounted at /app/config. Roles are set per user in the file.
OVP_AUTH_FILE=/app/config/users.yaml

# ldap: LDAP or Active Directory, over LDAPS or StartTLS only.
OVP_LDAP_HOST=
OVP_LDAP_PORT=
# ldaps | starttls
OVP_LDAP_SECURITY=ldaps
# PEM of the authority that issued the directory's certificate, when the system does not trust it.
OVP_LDAP_CA_CERT_PATH=
OVP_LDAP_BIND_DN=
OVP_LDAP_BIND_PASSWORD=
OVP_LDAP_BASE_DN=
OVP_LDAP_ACTIVE_DIRECTORY=true
OVP_LDAP_USER_FILTER=
OVP_LDAP_DISPLAY_NAME_ATTRIBUTE=
# required. Distinguished name of the group whose members are ADMINISTRATORS, for example
# CN=OVP Admins,OU=Groups,DC=corp,DC=example,DC=com. Nested groups count in Active Directory.
OVP_LDAP_ADMIN_GROUP=
# Distinguished name of the group whose members may sign in as USERS. Set it: when empty, everyone the
# user filter finds may sign in. Administrators need not be in it.
OVP_LDAP_USER_GROUP=

# entra: Entra ID.
# The identity platform of the tenant's cloud; change only for a national cloud.
OVP_ENTRA_INSTANCE=https://login.microsoftonline.com
OVP_ENTRA_TENANT_ID=
OVP_ENTRA_CLIENT_ID=
OVP_ENTRA_AUDIENCE=
OVP_ENTRA_SCOPE=
# Who is an ADMINISTRATOR: holders of this app role, or members of this group (object id).
OVP_ENTRA_ADMIN_ROLE=Admin
OVP_ENTRA_ADMIN_GROUP=
# Who may sign in as a USER: holders of this app role, or members of this group (object id).
# With OVP_ENTRA_USER_GROUP set or OVP_ENTRA_REQUIRE_ROLE=true, anyone else is refused;
# with neither, everyone in the tenant may sign in as a user.
OVP_ENTRA_USER_ROLE=User
OVP_ENTRA_USER_GROUP=
OVP_ENTRA_REQUIRE_ROLE=false
OVP_ENTRA_REAUTH_HOURS=8

# --- Clients ----------------------------------------------------------------------------------
OVP_MIN_CLIENT_VERSION=0.0.0
OVP_CLOCK_SKEW_SECONDS=300

# --- Logging ----------------------------------------------------------------------------------
# Verbose | Debug | Information | Warning | Error | Fatal
OVP_LOG_LEVEL=Information
OVP_LOG_DIRECTORY=/app/logs
OVP_LOG_RETENTION_DAYS=7
# Time zone for log timestamps and the daily folders.
TZ=UTC

# --- Health -----------------------------------------------------------------------------------
# Nothing to set. /health/live is what the container's own health check asks; /health and
# /health/ready also check the database. All three are anonymous and need no headers.
