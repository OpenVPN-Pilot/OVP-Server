# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
publish/
*.user
*.suo
*.userosscache
*.sln.docstates

# IDE
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# Deployment state. Secrets, user lists and certificates belong to one installation, never to git.
.env
appsettings.Local.json
appsettings.Development.json
/config/*
!/config/users.example.yaml
/certs/
/logs/
/data/

# OpenVPN material. Configurations and keys must never enter the repository.
*.ovpn
*.key
*.crt
*.pem
*.p12
*.pfx

# Databases and dumps
*.db
*.db-shm
*.db-wal
*.sql.gz
*.dump

# Local working notes. Travel with a copied folder, never with a push.
PLAN.md
TODO.local.md

# OS noise
Thumbs.db
desktop.ini
.DS_Store
